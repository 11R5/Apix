<?xml version="1.0"?>
<definitions targetNamespace="urn:apix:more" name="More"
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:m="urn:apix:more">
  <message name="PingIn"/>
  <portType name="More">
    <operation name="Ping"><input message="m:PingIn"/></operation>
  </portType>
  <binding name="MoreSoap" type="m:More">
    <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="Ping">
      <soap:operation soapAction="urn:ping"/>
      <input><soap:body use="literal"/></input>
    </operation>
  </binding>
  <service name="MoreService">
    <port name="MorePort" binding="m:MoreSoap">
      <soap:address location="https://more.example.com/soap"/>
    </port>
  </service>
</definitions>
