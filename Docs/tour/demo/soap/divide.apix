name = "Divide"
method = "POST"
url = "http://127.0.0.1:8773/calculator"

[[headers]]
key = "Content-Type"
value = "text/xml; charset=utf-8"

[[headers]]
key = "SOAPAction"
value = '"urn:apix:calculator/Divide"'

[body]
xml = """
<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:tns="urn:apix:calculator">
  <soap:Header>
    <tns:Trace>docs</tns:Trace>
  </soap:Header>
  <soap:Body>
    <tns:Divide>
      <tns:dividend>10</tns:dividend>
      <tns:divisor>0</tns:divisor>
    </tns:Divide>
  </soap:Body>
</soap:Envelope>
"""
